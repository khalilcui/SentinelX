# Copy this file to .env and adjust values before running.

# Database — defaults to a local SQLite file, no setup required.
# For production, point this at PostgreSQL instead, e.g.:
# DATABASE_URL=postgresql+psycopg2://sentinelx:sentinelx@db:5432/sentinelx
DATABASE_URL=sqlite:///./sentinelx.db

# JWT
SECRET_KEY=change-this-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Where generated PDF reports are written on disk
REPORTS_DIR=./generated_reports
